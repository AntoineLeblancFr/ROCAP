#################################################################
#    Annotations
#################################################################

:Attack rdfs:label "Attack"@en .


:Attacker rdfs:label "Attacker"@en .


:CausalLikelihood rdfs:label "Causal Likelihood"@en .


:ControlCapability rdfs:label "Control Capability"@en .


:ControlCapabilityType rdfs:label "Control Capability Type"@en ;
                       gufo:categorizes :ControlCapability .


:ControlChainEvent rdfs:label "Control Chain Event"@en .


:ControlEvent rdfs:label "Control Event"@en .


:ControlEventType gufo:categorizes :ControlEvent ;
                  rdfs:label "Control Event Type"@en .


:ControlledSituation rdfs:label "Controlled Situation"@en .


:ControlledSituationType rdfs:label "Controlled Situation Type"@en ;
                         gufo:categorizes :ControlledSituation .


:Disposition rdfs:label "Disposition"@en .


:ExperienceRiskAssesment rdfs:label "Experience Risk Assesment"@en .


:ExperienceValueAsc rdfs:label "Experience Value Asc."@en .


:GenericIntention rdfs:label "Generic Intention"@en .


:ImpactEvent rdfs:label "Impact Event"@en .


:ImpactfulOutcome rdfs:label "Impactful Outcome"@en .


:Intention rdfs:label "Intention"@en .


:IntentionType rdfs:label "Intention Type"@en ;
               gufo:categorizes :Intention .


:LossEvent rdfs:label "Loss Event"@en .


:LossEventType gufo:categorizes :LossEvent ;
               rdfs:label "Loss Event Type"@en .


:LossSituation rdfs:label "Loss Situation"@en .


:LossSituationType gufo:categorizes :LossSituation ;
                   rdfs:label "Loss Situation Type"@en .


:LossTriggeringSituation rdfs:label "Loss Triggering Situation"@en .


:LossTriggeringSituationType rdfs:label "Loss Triggering Situation Type"@en .


:ObjectAtRisk rdfs:label "Object at Risk"@en .


:ObjectRiskAssesment rdfs:label "Object Risk Assesment"@en .


:ObjectValueAsc rdfs:label "Object Value Asc."@en .


:ProtectedSubject rdfs:label "Protected Subject"@en .


:ProtectionEvent rdfs:label "Protection Event"@en .


:ProtectionTrigger rdfs:label "Protection Trigger"@en .


:Risk rdfs:label "Risk"@en .


:RiskAssessment rdfs:label "Risk Assessment"@en .


:RiskAssessor rdfs:label "Risk Assessor"@en .


:RiskEnabler rdfs:label "Risk Enabler"@en .


:RiskEvent rdfs:label "Risk Event"@en .


:RiskEventType gufo:categorizes :RiskEvent ;
               rdfs:label "Risk Event Type"@en .


:RiskExperience rdfs:label "Risk Experience"@en .


:RiskSubject rdfs:label "Risk Subject"@en .


:SecurityDesigner rdfs:label "Security Designer"@en .


:SecurityMechanism rdfs:label "Security Mechanism"@en .


:SpecificIntention rdfs:label "Specific Intention"@en .


:ThreatCapability rdfs:label "Threat Capability"@en .


:ThreatCapabilityType gufo:categorizes :ThreatCapability ;
                      rdfs:label "Threat Capability Type"@en .


:ThreatEvent rdfs:label "Threat Event"@en .


