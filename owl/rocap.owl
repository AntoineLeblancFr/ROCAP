@prefix : <http://rocap.com#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://rocap.com> .

<http://rocap.com> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/nemo/gufo#categorizes
gufo:categorizes rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#minQualifiedCardinality
owl:minQualifiedCardinality rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/nemo/gufo#broughtAbout
gufo:broughtAbout rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#contributedToTrigger
gufo:contributedToTrigger rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#historicallyDependsOn
gufo:historicallyDependsOn rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#inheresIn
gufo:inheresIn rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#manifestedIn
gufo:manifestedIn rdf:type owl:ObjectProperty .


###  http://purl.org/nemo/gufo#participatedIn
gufo:participatedIn rdf:type owl:ObjectProperty .


###  http://rocap.com#bringingAboutOf
:bringingAboutOf rdf:type owl:ObjectProperty ;
                 rdfs:domain :ControlEventType ;
                 rdfs:range :ControlledSituationType ;
                 rdfs:label "bringing about of"@en .


###  http://rocap.com#causation
:causation rdf:type owl:ObjectProperty ;
           rdfs:domain :ThreatEventType ;
           rdfs:range :LossEventType ;
           rdfs:label "causation"@en .


###  http://rocap.com#causedBy
:causedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :UFOAction ;
          rdfs:range :Intention ;
          rdfs:label "caused by"@en .


###  http://rocap.com#causedBy_1
### An Attack is a manifestation of the Intention it realizes. In UFO-C the
### action-to-intention relation is glossed "caused by"; we keep it as the
### manifestation reading (an Action manifests the Intention of which it is the
### manifestation), consistent with :manifestsAttackPlan above.
:causedBy_1 rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :causedBy ;
            rdfs:domain :Attack ;
            rdfs:range :Intention ;
            rdfs:label "manifestation of"@en .


###  http://rocap.com#causes_2
:causes_2 rdf:type owl:ObjectProperty ;
          rdfs:domain :RiskEvent ;
          rdfs:range :RiskEvent ;
          rdfs:label "causes"@en .


###  http://rocap.com#countermeasureTo
:countermeasureTo rdf:type owl:ObjectProperty ;
                  rdfs:domain :SecurityMechanism ;
                  rdfs:range :RiskEventType ;
                  rdfs:label "countermeasure to"@en .


###  http://rocap.com#participatesInAction
### (was :creates -- ROSE "creates" replaced by UFO participation, Figs. 1 & 3:
###  an Agent PARTICIPATES IN an Action; it does not "create" it)
:participatesInAction rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf gufo:participatedIn ;
         rdfs:domain :UFOAgent ;
         rdfs:range :UFOAction ;
         rdfs:label "participates in"@en .


###  http://rocap.com#participatesInAttack
### (was :creates_1 -- the Attacker PARTICIPATES IN the Attack, Figs. 1 & 3)
:participatesInAttack rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :participatesInAction ;
           rdfs:domain :Attacker ;
           rdfs:range :Attack ;
           rdfs:label "participates in"@en .


###  http://rocap.com#designedBy
:designedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :SecurityMechanism ;
            rdfs:range :SecurityDesigner ;
            rdfs:label "designed by"@en .


###  http://rocap.com#directlyCauses
:directlyCauses rdf:type owl:ObjectProperty ;
                rdfs:domain :ValueEvent ;
                rdfs:range :ValueEvent ;
                rdfs:label "directly causes"@en .


###  http://rocap.com#experienceRiskAssesmentHasIntention
:experienceRiskAssesmentHasIntention rdf:type owl:ObjectProperty ;
                                     rdfs:domain :ExperienceRiskAssesment ;
                                     rdfs:range :Intention .


###  http://rocap.com#experienceRiskAssesmentHasThreatCapability
:experienceRiskAssesmentHasThreatCapability rdf:type owl:ObjectProperty ;
                                            rdfs:domain :ExperienceRiskAssesment ;
                                            rdfs:range :ThreatCapability .


###  http://rocap.com#experienceRiskAssesmentHasVulnerability
:experienceRiskAssesmentHasVulnerability rdf:type owl:ObjectProperty ;
                                         rdfs:domain :ExperienceRiskAssesment ;
                                         rdfs:range :Vulnerability .


###  http://rocap.com#experienceValueAscHasDisposition
:experienceValueAscHasDisposition rdf:type owl:ObjectProperty ;
                                  rdfs:domain :ExperienceValueAsc ;
                                  rdfs:range :Disposition .


###  http://rocap.com#experienceValueAscHasIntention
:experienceValueAscHasIntention rdf:type owl:ObjectProperty ;
                                rdfs:domain :ExperienceValueAsc ;
                                rdfs:range :Intention .


###  http://rocap.com#hurts
:hurts rdf:type owl:ObjectProperty ;
       rdfs:domain :LossSituation ;
       rdfs:range :Intention ;
       rdfs:label "hurts"@en .


###  http://rocap.com#hurts_1
:hurts_1 rdf:type owl:ObjectProperty ;
         rdfs:domain :LossEvent ;
         rdfs:range :Intention ;
         rdfs:label "hurts"@en .


###  http://rocap.com#impacts
:impacts rdf:type owl:ObjectProperty ;
         rdfs:domain :ImpactfulOutcome ;
         rdfs:range :Intention ;
         rdfs:label "impacts"@en .


###  http://rocap.com#impacts_1
:impacts_1 rdf:type owl:ObjectProperty ;
           rdfs:domain :ControlledSituation ;
           rdfs:range :Intention ;
           rdfs:label "impacts"@en .


###  http://rocap.com#impacts_2
:impacts_2 rdf:type owl:ObjectProperty ;
           rdfs:domain :ImpactEvent ;
           rdfs:range :Intention ;
           rdfs:label "impacts"@en .


###  http://rocap.com#incompatibleWith
:incompatibleWith rdf:type owl:ObjectProperty ;
                  rdfs:domain :ControlledSituationType ;
                  rdfs:range :LossTriggeringSituationType ;
                  rdfs:label "incompatible with"@en .


###  http://rocap.com#incompatibleWith_1
:incompatibleWith_1 rdf:type owl:ObjectProperty ;
                    rdfs:domain :ControlledSituationType ;
                    rdfs:range :ThreateningSituationType ;
                    rdfs:label "incompatible with"@en .


###  http://rocap.com#involves
:involves rdf:type owl:ObjectProperty ;
          rdfs:domain :RiskAssessment ;
          rdfs:range :RiskAssessor ;
          rdfs:label "involves"@en .


###  http://rocap.com#involves_1
:involves_1 rdf:type owl:ObjectProperty ;
            rdfs:domain :ValueAscription ;
            rdfs:range :ValueAssessor ;
            rdfs:label "involves"@en .


###  http://rocap.com#involves_2
:involves_2 rdf:type owl:ObjectProperty ;
            rdfs:domain :ObjectRiskAssesment ;
            rdfs:range :ObjectAtRisk ;
            rdfs:label "involves"@en .


###  http://rocap.com#involves_3
:involves_3 rdf:type owl:ObjectProperty ;
            rdfs:domain :ExperienceValueAsc ;
            rdfs:range :ValueExperience ;
            rdfs:label "involves"@en .


###  http://rocap.com#involves_4
:involves_4 rdf:type owl:ObjectProperty ;
            rdfs:domain :ObjectValueAsc ;
            rdfs:range :ValueObject ;
            rdfs:label "involves"@en .


###  http://rocap.com#manifestation
:manifestation rdf:type owl:ObjectProperty ;
               rdfs:domain :ControlEventType ;
               rdfs:range :ControlCapabilityType ;
               rdfs:label "manifestation"@en .


###  http://rocap.com#manifestedBy
:manifestedBy rdf:type owl:ObjectProperty ;
              rdfs:domain :Disposition ;
              rdfs:range :ValueEvent ;
              rdfs:label "manifested by"@en .


###  http://rocap.com#mutualActivationPartnership
:mutualActivationPartnership rdf:type owl:ObjectProperty ;
                             rdfs:domain :ThreatCapabilityType ;
                             rdfs:range :VulnerabilityType ;
                             rdfs:label "mutual activation partnership"@en .


###  http://rocap.com#mutualActivationPartnership_1
:mutualActivationPartnership_1 rdf:type owl:ObjectProperty ;
                               rdfs:domain :ThreatCapabilityType ;
                               rdfs:range :IntentionType ;
                               rdfs:label "mutual activation partnership"@en .


###  http://rocap.com#objectRiskAssesmentHasExperienceRiskAssesment
:objectRiskAssesmentHasExperienceRiskAssesment rdf:type owl:ObjectProperty ;
                                               rdfs:domain :ObjectRiskAssesment ;
                                               rdfs:range :ExperienceRiskAssesment .


###  http://rocap.com#objectValueAscHasExperienceValueAsc
:objectValueAscHasExperienceValueAsc rdf:type owl:ObjectProperty ;
                                     rdfs:domain :ObjectValueAsc ;
                                     rdfs:range :ExperienceValueAsc .


###  http://rocap.com#participatesIn
:participatesIn rdf:type owl:ObjectProperty ;
                rdfs:domain :ValueSubject ;
                rdfs:range :ValueExperience ;
                rdfs:label "participates in"@en .


###  http://rocap.com#participatesIn_1
:participatesIn_1 rdf:type owl:ObjectProperty ;
                  rdfs:domain :ValueEnabler ;
                  rdfs:range :ValueExperience ;
                  rdfs:label "participates in"@en .


###  http://rocap.com#participatesIn_2
:participatesIn_2 rdf:type owl:ObjectProperty ;
                  rdfs:domain :ValueObject ;
                  rdfs:range :ValueExperience ;
                  rdfs:label "participates in"@en .


###  http://rocap.com#participatesIn_3
:participatesIn_3 rdf:type owl:ObjectProperty ;
                  rdfs:domain :ValueEnabler ;
                  rdfs:range :ValueEvent ;
                  rdfs:label "participates in"@en .


###  http://rocap.com#prevention
:prevention rdf:type owl:ObjectProperty ;
            rdfs:domain :ControlEventType ;
            rdfs:range :RiskEventType ;
            rdfs:label "prevention"@en .


###  http://rocap.com#riskExperienceHasRiskEvent
:riskExperienceHasRiskEvent rdf:type owl:ObjectProperty ;
                            rdfs:domain :RiskExperience ;
                            rdfs:range :RiskEvent .


###  http://rocap.com#triggering
:triggering rdf:type owl:ObjectProperty ;
            rdfs:domain :ThreateningSituationType ;
            rdfs:range :ThreatEventType ;
            rdfs:label "triggering"@en .


###  http://rocap.com#triggering_1
:triggering_1 rdf:type owl:ObjectProperty ;
              rdfs:domain :LossTriggeringSituationType ;
              rdfs:range :LossEventType ;
              rdfs:label "triggering"@en .



###  http://rocap.com#offensivelyEngagedBy
:offensivelyEngagedBy rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf gufo:participatedIn ;
                      rdfs:domain :SupportingAsset ;
                      rdfs:range  :Attack ;
                      rdfs:label  "offensively engaged by"@en .


###  http://rocap.com#offensivelyEngagedByType
:offensivelyEngagedByType rdf:type owl:ObjectProperty ;
                          rdfs:domain :SupportingAssetType ;
                          rdfs:range  :AttackType ;
                          rdfs:label  "offensively engaged by"@en .


###  http://rocap.com#manifestsAttackPlan
### (was :hasAttackPlan, mislabelled "caused by" -- per GG, an Attack is the
###  MANIFESTATION of the Attack Plan whose committed course of action it realizes)
:manifestsAttackPlan rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf gufo:manifestedIn ;
               rdfs:domain :Attack ;
               rdfs:range  :AttackPlan ;
               rdfs:label  "manifests"@en .


###  http://rocap.com#supportedBy
### (was :hasSupportingAsset, mislabelled "composed of" -- the Business/Supporting
###  Asset relation is a FUNCTIONAL DEPENDENCE, not parthood, Fig. 1 "supported by")
:supportedBy rdf:type owl:ObjectProperty ;
                    rdfs:domain :BusinessAsset ;
                    rdfs:range  :SupportingAsset ;
                    rdfs:label  "supported by"@en .


###  http://rocap.com#basedOn
### The Attack Plan (a closed intention) is BASED ON a Complex Action Type -- the
### structured course of action it commits to instantiating (Fig. 2).
:basedOn rdf:type owl:ObjectProperty ;
         rdfs:domain :AttackPlan ;
         rdfs:range  :ComplexActionType ;
         rdfs:label  "based on"@en .


###  http://rocap.com#hasCybersecurityValueComponent
:hasCybersecurityValueComponent rdf:type owl:ObjectProperty ;
                                rdfs:domain :BusinessAsset ;
                                rdfs:range  :CybersecurityValueComponent ;
                                rdfs:label  "characterization"@en .


###  http://rocap.com#externalDependenceOn
:externalDependenceOn rdf:type owl:ObjectProperty ;
                      rdfs:domain :CybersecurityValueComponent ;
                      rdfs:range  :ProtectedSubject ;
                      rdfs:label  "external dependence"@en .


###  http://rocap.com#attackerHasThreatCapability
:attackerHasThreatCapability rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf gufo:inheresIn ;
                             rdfs:domain :ThreatCapability ;
                             rdfs:range  :Attacker ;
                             rdfs:label  "characterization"@en .


###  http://rocap.com#untreatedRiskOf
:untreatedRiskOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf gufo:inheresIn ;
                 rdfs:domain :UntreatedRisk ;
                 rdfs:range  :ExperienceRiskAssesment ;
                 rdfs:label  "characterization"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/nemo/gufo#Category
gufo:Category rdf:type owl:Class .


###  http://purl.org/nemo/gufo#ConcreteIndividualType
gufo:ConcreteIndividualType rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Event
gufo:Event rdf:type owl:Class .


###  http://purl.org/nemo/gufo#EventType
gufo:EventType rdf:type owl:Class .


###  http://purl.org/nemo/gufo#FunctionalComplex
gufo:FunctionalComplex rdf:type owl:Class .


###  http://purl.org/nemo/gufo#IntrinsicMode
gufo:IntrinsicMode rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Kind
gufo:Kind rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Quality
gufo:Quality rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Relator
gufo:Relator rdf:type owl:Class .


###  http://purl.org/nemo/gufo#RoleMixin
gufo:RoleMixin rdf:type owl:Class .


###  http://purl.org/nemo/gufo#Situation
gufo:Situation rdf:type owl:Class .


###  http://purl.org/nemo/gufo#SituationType
gufo:SituationType rdf:type owl:Class .


###  http://purl.org/nemo/gufo#SubKind
gufo:SubKind rdf:type owl:Class .


###  http://rocap.com#Attack
:Attack rdf:type owl:Class ;
        rdfs:subClassOf :ThreatEvent ,
                        :UFOAction .


###  http://rocap.com#Attacker
:Attacker rdf:type owl:Class ;
          rdfs:subClassOf :ThreatObject ,
                          :UFOAgent ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty [ owl:inverseOf gufo:inheresIn
                                           ] ;
                            owl:someValuesFrom :Intention
                          ] .


###  http://rocap.com#CausalLikelihood
:CausalLikelihood rdf:type owl:Class ;
                  rdfs:subClassOf gufo:Quality ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gufo:inheresIn ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :UFOEventType
                                  ] .


###  http://rocap.com#ControlCapability
:ControlCapability rdf:type owl:Class ;
                   rdfs:subClassOf :Disposition ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty gufo:inheresIn ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :SecurityMechanism
                                   ] .


###  http://rocap.com#ControlCapabilityType
:ControlCapabilityType rdf:type owl:Class ;
                       rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#ControlChainEvent
:ControlChainEvent rdf:type owl:Class ;
                   rdfs:subClassOf :ProtectionEvent .


###  http://rocap.com#ControlEvent
:ControlEvent rdf:type owl:Class ;
              rdfs:subClassOf :ProtectionEvent ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:broughtAbout ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :ControlledSituation
                              ] .


###  http://rocap.com#ControlEventType
:ControlEventType rdf:type owl:Class ;
                  rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#ControlledSituation
:ControlledSituation rdf:type owl:Class ;
                     rdfs:subClassOf gufo:Situation .


###  http://rocap.com#ControlledSituationType
:ControlledSituationType rdf:type owl:Class ;
                         rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#Disposition
:Disposition rdf:type owl:Class ;
             rdfs:subClassOf gufo:IntrinsicMode .


###  http://rocap.com#ExperienceRiskAssesment
:ExperienceRiskAssesment rdf:type owl:Class ;
                         rdfs:subClassOf :RiskAssessment ;
                         owl:disjointWith :ObjectRiskAssesment .


###  http://rocap.com#ExperienceValueAsc
:ExperienceValueAsc rdf:type owl:Class ;
                    rdfs:subClassOf :ValueAscription ;
                    owl:disjointWith :ObjectValueAsc .


###  http://rocap.com#GenericIntention
:GenericIntention rdf:type owl:Class ;
                  rdfs:subClassOf :Intention ;
                  owl:disjointWith :SpecificIntention .


###  http://rocap.com#ImpactEvent
:ImpactEvent rdf:type owl:Class ;
             rdfs:subClassOf :ValueEvent ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:historicallyDependsOn
                                              ] ;
                               owl:someValuesFrom :TriggerEvent
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:broughtAbout ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ImpactfulOutcome
                             ] ;
             owl:disjointWith :TriggerEvent .


###  http://rocap.com#ImpactfulOutcome
:ImpactfulOutcome rdf:type owl:Class ;
                  rdfs:subClassOf gufo:Situation ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:broughtAbout
                                                   ] ;
                                    owl:someValuesFrom :ImpactEvent
                                  ] .


###  http://rocap.com#Intention
:Intention rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:unionOf ( :GenericIntention
                                               :SpecificIntention
                                             )
                               ] ;
           rdfs:subClassOf gufo:IntrinsicMode .


###  http://rocap.com#IntentionType
:IntentionType rdf:type owl:Class ;
               rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#LossEvent
:LossEvent rdf:type owl:Class ;
           rdfs:subClassOf :RiskEvent ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty gufo:broughtAbout ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :LossSituation
                           ] .


###  http://rocap.com#LossEventType
:LossEventType rdf:type owl:Class ;
               rdfs:subClassOf :RiskEventType .


###  http://rocap.com#LossSituation
:LossSituation rdf:type owl:Class ;
               rdfs:subClassOf gufo:Situation ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty [ owl:inverseOf gufo:broughtAbout
                                                ] ;
                                 owl:someValuesFrom :LossEvent
                               ] .


###  http://rocap.com#LossSituationType
:LossSituationType rdf:type owl:Class ;
                   rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#LossTriggeringSituation
:LossTriggeringSituation rdf:type owl:Class ;
                         rdfs:subClassOf gufo:Situation .


###  http://rocap.com#LossTriggeringSituationType
:LossTriggeringSituationType rdf:type owl:Class ;
                             rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#ObjectAtRisk
:ObjectAtRisk rdf:type owl:Class ;
              rdfs:subClassOf gufo:FunctionalComplex ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:participatedIn ;
                                owl:someValuesFrom :RiskExperience
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:inheresIn
                                               ] ;
                                owl:someValuesFrom :Vulnerability
                              ] .


###  http://rocap.com#ObjectRiskAssesment
:ObjectRiskAssesment rdf:type owl:Class ;
                     rdfs:subClassOf :RiskAssessment .


###  http://rocap.com#ObjectValueAsc
:ObjectValueAsc rdf:type owl:Class ;
                rdfs:subClassOf :ValueAscription .


###  http://rocap.com#ProtectedSubject
:ProtectedSubject rdf:type owl:Class ;
                  rdfs:subClassOf gufo:FunctionalComplex ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                   ] ;
                                    owl:someValuesFrom :Intention
                                  ] .


###  http://rocap.com#ProtectionEvent
:ProtectionEvent rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:unionOf ( :ControlChainEvent
                                                     :ControlEvent
                                                   )
                                     ] ;
                 rdfs:subClassOf gufo:Event ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty [ owl:inverseOf gufo:manifestedIn
                                                  ] ;
                                   owl:someValuesFrom :ControlCapability
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty [ owl:inverseOf gufo:contributedToTrigger
                                                  ] ;
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :ProtectionTrigger
                                 ] .


###  http://rocap.com#ProtectionTrigger
:ProtectionTrigger rdf:type owl:Class ;
                   rdfs:subClassOf gufo:Situation .


###  http://rocap.com#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf gufo:Quality ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty gufo:inheresIn ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :RiskAssessment
                      ] .


###  http://rocap.com#RiskAssessment
:RiskAssessment rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:unionOf ( :ExperienceRiskAssesment
                                                    :ObjectRiskAssesment
                                                  )
                                    ] ;
                rdfs:subClassOf gufo:Relator ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                 ] ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :Risk
                                ] .


###  http://rocap.com#RiskAssessor
:RiskAssessor rdf:type owl:Class ;
              rdfs:subClassOf :UFOAgent .


###  http://rocap.com#RiskEnabler
:RiskEnabler rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:participatedIn ;
                               owl:someValuesFrom :RiskEvent
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:participatedIn ;
                               owl:someValuesFrom :RiskExperience
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:inheresIn
                                              ] ;
                               owl:someValuesFrom :Vulnerability
                             ] .


###  http://rocap.com#RiskEvent
:RiskEvent rdf:type owl:Class ;
           rdfs:subClassOf gufo:Event ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty [ owl:inverseOf gufo:manifestedIn
                                            ] ;
                             owl:someValuesFrom :Vulnerability
                           ] .


###  http://rocap.com#RiskEventType
:RiskEventType rdf:type owl:Class ;
               rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#RiskExperience
:RiskExperience rdf:type owl:Class ;
                rdfs:subClassOf gufo:Event ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty [ owl:inverseOf gufo:participatedIn
                                                 ] ;
                                  owl:someValuesFrom :RiskSubject
                                ] .


###  http://rocap.com#RiskSubject
:RiskSubject rdf:type owl:Class ;
             rdfs:subClassOf :UFOAgent ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty gufo:participatedIn ;
                               owl:someValuesFrom :RiskExperience
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:inheresIn
                                              ] ;
                               owl:someValuesFrom :Intention
                             ] .


###  http://rocap.com#SecurityDesigner
:SecurityDesigner rdf:type owl:Class ;
                  rdfs:subClassOf gufo:FunctionalComplex ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                   ] ;
                                    owl:someValuesFrom :Intention
                                  ] .


###  http://rocap.com#SecurityMechanism
:SecurityMechanism rdf:type owl:Class ;
                   rdfs:subClassOf gufo:FunctionalComplex ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                    ] ;
                                     owl:someValuesFrom :ControlCapability
                                   ] .


###  http://rocap.com#SpecificIntention
:SpecificIntention rdf:type owl:Class ;
                   rdfs:subClassOf :Intention .


###  http://rocap.com#ThreatCapability
:ThreatCapability rdf:type owl:Class ;
                  rdfs:subClassOf :Disposition ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gufo:manifestedIn ;
                                    owl:someValuesFrom :ThreatEvent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty gufo:inheresIn ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass :ThreatObject
                                  ] .


###  http://rocap.com#ThreatCapabilityType
:ThreatCapabilityType rdf:type owl:Class ;
                      rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#ThreatEvent
:ThreatEvent rdf:type owl:Class ;
             rdfs:subClassOf :RiskEvent ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:contributedToTrigger
                                              ] ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :ThreateningSituation
                             ] .


###  http://rocap.com#ThreatEventType
:ThreatEventType rdf:type owl:Class ;
                 rdfs:subClassOf :RiskEventType .


###  http://rocap.com#ThreatObject
:ThreatObject rdf:type owl:Class ;
              rdfs:subClassOf gufo:FunctionalComplex ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:participatedIn ;
                                owl:someValuesFrom :RiskExperience
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:participatedIn ;
                                owl:someValuesFrom :ThreatEvent
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:inheresIn
                                               ] ;
                                owl:someValuesFrom :ThreatCapability
                              ] .


###  http://rocap.com#ThreateningSituation
:ThreateningSituation rdf:type owl:Class ;
                      rdfs:subClassOf gufo:Situation .


###  http://rocap.com#ThreateningSituationType
:ThreateningSituationType rdf:type owl:Class ;
                          rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#TriggerEvent
:TriggerEvent rdf:type owl:Class ;
              rdfs:subClassOf :ValueEvent ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty gufo:historicallyDependsOn ;
                                owl:someValuesFrom :ImpactEvent
                              ] .


###  http://rocap.com#TriggeringLikelihood
:TriggeringLikelihood rdf:type owl:Class ;
                      rdfs:subClassOf gufo:Quality ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty gufo:inheresIn ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :UFOSituationType
                                      ] .


###  http://rocap.com#UFOAction
:UFOAction rdf:type owl:Class ;
           rdfs:subClassOf gufo:Event .


###  http://rocap.com#UFOAgent
:UFOAgent rdf:type owl:Class ;
          rdfs:subClassOf gufo:FunctionalComplex .


###  http://rocap.com#UFOEvent
:UFOEvent rdf:type owl:Class ;
          rdfs:subClassOf gufo:Event ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty [ owl:inverseOf gufo:contributedToTrigger
                                           ] ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :UFOSituation
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty gufo:broughtAbout ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :UFOSituation
                          ] .


###  http://rocap.com#UFOEventType
:UFOEventType rdf:type owl:Class ;
              rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#UFOSituation
:UFOSituation rdf:type owl:Class ;
              rdfs:subClassOf gufo:Situation .


###  http://rocap.com#UFOSituationType
:UFOSituationType rdf:type owl:Class ;
                  rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#Value
:Value rdf:type owl:Class ;
       rdfs:subClassOf gufo:Quality ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty gufo:inheresIn ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :ValueAscription
                       ] .


###  http://rocap.com#ValueAscription
:ValueAscription rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:unionOf ( :ExperienceValueAsc
                                                     :ObjectValueAsc
                                                   )
                                     ] ;
                 rdfs:subClassOf gufo:Relator ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                  ] ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Value
                                 ] .


###  http://rocap.com#ValueAssessor
:ValueAssessor rdf:type owl:Class ;
               rdfs:subClassOf gufo:FunctionalComplex .


###  http://rocap.com#ValueEnabler
:ValueEnabler rdf:type owl:Class ;
              rdfs:subClassOf gufo:FunctionalComplex ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:inheresIn
                                               ] ;
                                owl:someValuesFrom :Disposition
                              ] .


###  http://rocap.com#ValueEvent
:ValueEvent rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:unionOf ( :ImpactEvent
                                                :TriggerEvent
                                              )
                                ] ;
            rdfs:subClassOf gufo:Event .


###  http://rocap.com#ValueExperience
:ValueExperience rdf:type owl:Class ;
                 rdfs:subClassOf gufo:Event .


###  http://rocap.com#ValueObject
:ValueObject rdf:type owl:Class ;
             rdfs:subClassOf gufo:FunctionalComplex ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty [ owl:inverseOf gufo:inheresIn
                                              ] ;
                               owl:someValuesFrom :Disposition
                             ] .


###  http://rocap.com#ValueSubject
:ValueSubject rdf:type owl:Class ;
              rdfs:subClassOf :UFOAgent ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty [ owl:inverseOf gufo:inheresIn
                                               ] ;
                                owl:someValuesFrom :Intention
                              ] .


###  http://rocap.com#Vulnerability
:Vulnerability rdf:type owl:Class ;
               rdfs:subClassOf :Disposition ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty gufo:manifestedIn ;
                                 owl:someValuesFrom :RiskEvent
                               ] .


###  http://rocap.com#VulnerabilityType
:VulnerabilityType rdf:type owl:Class ;
                   rdfs:subClassOf gufo:ConcreteIndividualType .

###  http://rocap.com#SupportingAsset
### A role played by an Endurant (physical or not): a server, an operating system,
### a virtual machine, a deployed business application, or a human resource.
:SupportingAsset rdf:type owl:Class ;
                 rdfs:subClassOf :RiskEnabler ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty gufo:participatedIn ;
                                   owl:someValuesFrom :Attack
                                 ] .



#################################################################
#    ROCA Classes (extends rocap)
#################################################################

###  http://rocap.com#ClosedIntention
:ClosedIntention rdf:type owl:Class ;
                 rdfs:subClassOf :Intention .


###  http://rocap.com#AttackPlan
### A closed intention (a UFO mode) that INHERES IN the Attacker (Fig. 1)
### and is MANIFESTED BY the Attacks realizing its committed course of action (Fig. 3).
:AttackPlan rdf:type owl:Class ;
            rdfs:subClassOf :ClosedIntention ,
                            gufo:IntrinsicMode ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty gufo:inheresIn ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Attacker
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty [ owl:inverseOf :manifestsAttackPlan ] ;
                              owl:someValuesFrom :Attack
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :basedOn ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :ComplexActionType
                            ] .


###  http://rocap.com#BusinessAsset
### An organizational component bearing value. Its dependence on Supporting Assets
### is FUNCTIONAL and CONTINGENT (Fig. 1): a Business Asset can exist without
### supporting assets but cannot realize its value without them -- hence
### someValuesFrom rather than a min-1 cardinality.
:BusinessAsset rdf:type owl:Class ;
               rdfs:subClassOf :ObjectAtRisk ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :supportedBy ;
                                 owl:someValuesFrom :SupportingAsset
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasCybersecurityValueComponent ;
                                 owl:someValuesFrom :CybersecurityValueComponent
                               ] .


###  http://rocap.com#CybersecurityValueComponent
:CybersecurityValueComponent rdf:type owl:Class ;
                             rdfs:subClassOf gufo:IntrinsicMode ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :externalDependenceOn ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :ProtectedSubject
                                             ] .


###  http://rocap.com#ComplexActionType
### The structured course of action to which the Attack Plan commits (Fig. 2).
### Its instances are structured patterns of events (scripts); the individual
### attack steps that instantiate them stand in gufo:historicallyDependsOn.
:ComplexActionType rdf:type owl:Class ;
                   rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#AttackType
:AttackType rdf:type owl:Class ;
            rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#CAPECPattern
:CAPECPattern rdf:type owl:Class ;
              rdfs:subClassOf :AttackType .


###  http://rocap.com#ATTCKTactic
:ATTCKTactic rdf:type owl:Class ;
             rdfs:subClassOf :AttackType .


###  http://rocap.com#ATTCKTechnique
:ATTCKTechnique rdf:type owl:Class ;
                rdfs:subClassOf :AttackType .


###  http://rocap.com#SupportingAssetType
:SupportingAssetType rdf:type owl:Class ;
                     rdfs:subClassOf gufo:ConcreteIndividualType .


###  http://rocap.com#HumanResource
:HumanResource rdf:type owl:Class ;
               rdfs:subClassOf :SupportingAssetType .


###  http://rocap.com#D3FENDArtifact
:D3FENDArtifact rdf:type owl:Class ;
                rdfs:subClassOf :SupportingAssetType .


###  http://rocap.com#CWEWeakness
:CWEWeakness rdf:type owl:Class ;
             rdfs:subClassOf :VulnerabilityType .


###  http://rocap.com#CVEVulnerability
:CVEVulnerability rdf:type owl:Class ;
                  rdfs:subClassOf :CWEWeakness .


###  http://rocap.com#HumanVulnerability
:HumanVulnerability rdf:type owl:Class ;
                    rdfs:subClassOf :VulnerabilityType .


###  http://rocap.com#UntreatedRisk
:UntreatedRisk rdf:type owl:Class ;
               rdfs:subClassOf :Risk ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :untreatedRiskOf ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass :ExperienceRiskAssesment
                               ] .


